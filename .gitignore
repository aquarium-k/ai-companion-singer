# 这个仓库只提交「源码 / 脚本 / 文档 / 3D 模型」，
# 下面每一条都别随手删——尤其是带 ⚠️ 的。

# ---- 依赖与构建产物 ----------------------------------------------------------
node_modules/
dist/
release/
*.map

# ---- 运行时数据 --------------------------------------------------------------
# ⚠️ 里面有本机的音乐路径、上次导入的任务、日志（个人数据，不该公开）
data/

# ---- 几 GB 的实验材料 / 本地运行时 -------------------------------------------
.tmp*/
.cache/
.pylibs/
.svclibs/
# SVC / RMVPE 的模型权重（956 MB，`tools/fetch_*` 下载的，可重下）
checkpoints/
__pycache__/
*.pyc

# 366 MB 实验截图（发布用的图单独挑，放 docs/img/ 再提交）
shots/

# ---- ⚠️ 曲包 ----------------------------------------------------------------
# 用户自己的歌 + 人声分离轨 + 翻唱，版权都不属于本项目，绝对不进公开仓库
public/songpacks/

# ---- 和声采样的烘焙中间产物 --------------------------------------------------
# 原始长音、SVC 源素材、修音备份：都是同一首歌的录音片段，体积也大。
# 运行时只要 public/voices/ 下那 103 段成品（*.wav + *.json）。
public/voices/_orig/
public/voices/_work/
public/voices/_orig_stretch/
public/voices/_orig_rebake/

# ---- 模型 -------------------------------------------------------------------
# ⚠️ text.vrm 的 VRM 许可只到「作者本人 + 非商用」，不能公开分发；
# saki.vrm 允许分发（avatarPermission: everyone），所以保留提交。
models/text.vrm

# ---- 编辑器 / 系统 -----------------------------------------------------------
.DS_Store
Thumbs.db
*.log
.vscode/
.idea/
